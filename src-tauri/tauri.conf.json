{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "DSH Pro Max",
  "version": "0.3.6",
  "identifier": "com.dsh.pro.max",
  "build": {
    "beforeDevCommand": "pnpm run build:dsh-plugins && pnpm run dev",
    "beforeBuildCommand": "pnpm run build:dsh-plugins && pnpm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173"
    },
    "windows": [
      {
        "label": "main",
        "title": "DSH Pro Max",
        "width": 960,
        "height": 680,
        "resizable": true,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "decorations": true,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../.artifacts/dsh-plugins/dsh-client-connection-authz-62ab96c0b126.tgz": "dsh-plugins/dsh-client-connection-authz-62ab96c0b126.tgz",
      "../.artifacts/dsh-plugins/dsh-auth-tailscale-01666104af53.tgz": "dsh-plugins/dsh-auth-tailscale-01666104af53.tgz"
    },
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "shell": {
      "open": "(https?://.+|/.+|[A-Za-z]:.+)"
    },
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
